# Production is the safe default. Set both values for local debugging and use compose.dev.yaml.
DEVELOPMENT=false
SPRING_PROFILES_ACTIVE=production

# Compose publishes only HTTP port 80. PostgreSQL and Redis stay on the private network.
POSTGRES_VOLUME_NAME=solaris_postgres_data
REDIS_VOLUME_NAME=solaris_redis_data

# These host values are used when the backend runs directly on the workstation.
# Compose overrides them with the postgres and redis service names.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=solaris
DB_USER=solaris
DB_PASSWORD=change-me-to-a-strong-local-password

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Use at least 32 random bytes. Never commit the real value.
JWT_SECRET=change-me-to-a-random-secret-of-at-least-32-bytes

JWT_ACCESS_TOKEN_TTL=15m
JWT_REFRESH_TOKEN_TTL=7d

MONITORING_FIXED_DELAY=60000
