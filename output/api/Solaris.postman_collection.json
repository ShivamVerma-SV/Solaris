{
  "info": {
    "_postman_id": "df3d6f77-8526-4e51-914c-bd8c115151d7",
    "name": "Solaris Backend API",
    "description": "Complete Solaris API collection. Set the credential variables, run Admin Login and Homeowner Login, then use the CRUD folders in order. Tokens and created resource IDs are saved automatically.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "noauth"
  },
  "event": [
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "pm.test('No unexpected server error', function () { pm.expect(pm.response.code).to.be.below(500); });",
          "if (pm.response.headers.get('Content-Type')) { pm.test('Response is JSON when a body is present', function () { if (pm.response.text()) pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json'); }); }"
        ]
      }
    }
  ],
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" },
    { "key": "adminEmail", "value": "admin@example.com" },
    { "key": "adminPassword", "value": "change-me" },
    { "key": "homeownerEmail", "value": "homeowner@example.com" },
    { "key": "homeownerPassword", "value": "change-me" },
    { "key": "adminAccessToken", "value": "" },
    { "key": "adminRefreshToken", "value": "" },
    { "key": "homeownerAccessToken", "value": "" },
    { "key": "homeownerRefreshToken", "value": "" },
    { "key": "homeownerUserId", "value": "" },
    { "key": "managedUserId", "value": "" },
    { "key": "siteId", "value": "" },
    { "key": "deviceId", "value": "" },
    { "key": "batteryId", "value": "" },
    { "key": "alertId", "value": "" },
    { "key": "fromInstant", "value": "2026-01-01T00:00:00Z" },
    { "key": "toInstant", "value": "2026-12-31T23:59:59Z" },
    { "key": "fromDate", "value": "2026-01-01" },
    { "key": "toDate", "value": "2026-12-31" }
  ],
  "item": [
    {
      "name": "Authentication",
      "description": "Public endpoints. Access tokens authenticate API requests; refresh tokens are rotated and held server-side in Redis.",
      "item": [
        {
          "name": "Register Homeowner",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Solar Homeowner\",\n  \"email\": \"{{homeownerEmail}}\",\n  \"password\": \"{{homeownerPassword}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/auth/register",
            "description": "Creates a HOMEOWNER account. Public registration cannot choose ADMIN. Expected: 201; duplicate email: 409."
          }
        },
        {
          "name": "Admin Login",
          "event": [{
            "listen": "test",
            "script": {
              "type": "text/javascript",
              "exec": [
                "pm.test('Login succeeded', function () { pm.response.to.have.status(200); });",
                "if (pm.response.code === 200) { const data = pm.response.json(); pm.collectionVariables.set('adminAccessToken', data.accessToken); pm.collectionVariables.set('adminRefreshToken', data.refreshToken); }"
              ]
            }
          }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/auth/login",
            "description": "Authenticates an existing controlled ADMIN account and saves its access and refresh tokens."
          }
        },
        {
          "name": "Homeowner Login",
          "event": [{
            "listen": "test",
            "script": {
              "type": "text/javascript",
              "exec": [
                "pm.test('Login succeeded', function () { pm.response.to.have.status(200); });",
                "if (pm.response.code === 200) { const data = pm.response.json(); pm.collectionVariables.set('homeownerAccessToken', data.accessToken); pm.collectionVariables.set('homeownerRefreshToken', data.refreshToken); pm.collectionVariables.set('homeownerUserId', data.userId); }"
              ]
            }
          }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{homeownerEmail}}\",\n  \"password\": \"{{homeownerPassword}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/auth/login",
            "description": "Authenticates a homeowner and saves the token pair and user ID."
          }
        },
        {
          "name": "Refresh Homeowner Token Pair",
          "event": [{
            "listen": "test",
            "script": {
              "type": "text/javascript",
              "exec": [
                "pm.test('Refresh succeeded', function () { pm.response.to.have.status(200); });",
                "if (pm.response.code === 200) { const data = pm.response.json(); pm.collectionVariables.set('homeownerAccessToken', data.accessToken); pm.collectionVariables.set('homeownerRefreshToken', data.refreshToken); }"
              ]
            }
          }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{homeownerRefreshToken}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/auth/refresh",
            "description": "Consumes the current refresh token and returns a new access/refresh pair. The old refresh token cannot be replayed."
          }
        },
        {
          "name": "Logout Homeowner",
          "event": [{
            "listen": "test",
            "script": {
              "type": "text/javascript",
              "exec": [
                "pm.test('Logout succeeded', function () { pm.response.to.have.status(204); });",
                "if (pm.response.code === 204) { pm.collectionVariables.set('homeownerAccessToken', ''); pm.collectionVariables.set('homeownerRefreshToken', ''); }"
              ]
            }
          }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{homeownerRefreshToken}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/auth/logout",
            "description": "Revokes the supplied refresh token in Redis. Access tokens remain valid until their short expiry."
          }
        }
      ]
    },
    {
      "name": "Admin - Users",
      "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{adminAccessToken}}", "type": "string" }] },
      "item": [
        {
          "name": "List Users",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/admin/users?page=0&size=20", "description": "Returns a paginated user list without password hashes." }
        },
        {
          "name": "Get User",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/admin/users/{{managedUserId}}", "description": "Returns one user by ID; missing IDs return 404." }
        },
        {
          "name": "Create User",
          "event": [{
            "listen": "test",
            "script": { "type": "text/javascript", "exec": [
              "pm.test('User created', function () { pm.response.to.have.status(201); });",
              "if (pm.response.code === 201) pm.collectionVariables.set('managedUserId', pm.response.json().id);"
            ] }
          }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Managed Homeowner\",\n  \"email\": \"managed.homeowner@example.com\",\n  \"password\": \"StrongPassword123!\",\n  \"role\": \"HOMEOWNER\",\n  \"phone\": \"+1 555 0100\",\n  \"enabled\": true\n}", "options": { "raw": { "language": "json" } } },
            "url": "{{baseUrl}}/api/admin/users",
            "description": "Creates a HOMEOWNER or controlled ADMIN. Duplicate email returns 409."
          }
        },
        {
          "name": "Update User",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Managed Homeowner Updated\",\n  \"email\": \"managed.homeowner@example.com\",\n  \"role\": \"HOMEOWNER\",\n  \"password\": null,\n  \"phone\": \"+1 555 0101\",\n  \"enabled\": true\n}", "options": { "raw": { "language": "json" } } },
            "url": "{{baseUrl}}/api/admin/users/{{managedUserId}}",
            "description": "Updates identity, role, enabled state, and optionally password. Null password preserves the current hash."
          }
        },
        {
          "name": "Delete User",
          "request": { "method": "DELETE", "url": "{{baseUrl}}/api/admin/users/{{managedUserId}}", "description": "Deletes a user. Self-deletion is forbidden, and the last enabled administrator is protected." }
        }
      ]
    },
    {
      "name": "Admin - Sites",
      "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{adminAccessToken}}", "type": "string" }] },
      "item": [
        { "name": "List Sites", "request": { "method": "GET", "url": "{{baseUrl}}/api/admin/sites?page=0&size=20", "description": "Returns sites in pages sorted by name." } },
        { "name": "Get Site", "request": { "method": "GET", "url": "{{baseUrl}}/api/admin/sites/{{siteId}}", "description": "Returns one solar site." } },
        {
          "name": "Create Site",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Site created', function () { pm.response.to.have.status(201); });",
            "if (pm.response.code === 201) pm.collectionVariables.set('siteId', pm.response.json().id);"
          ] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"ownerId\": {{homeownerUserId}},\n  \"code\": \"HOME-001\",\n  \"name\": \"Primary Residence\",\n  \"address\": \"1 Solar Way\",\n  \"capacityKw\": 8.5,\n  \"active\": true\n}", "options": { "raw": { "language": "json" } } },
            "url": "{{baseUrl}}/api/admin/sites",
            "description": "Assigns a unique site code to a HOMEOWNER. ADMIN users cannot own sites."
          }
        },
        {
          "name": "Update Site",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"ownerId\": {{homeownerUserId}},\n  \"code\": \"HOME-001\",\n  \"name\": \"Primary Residence Updated\",\n  \"address\": \"1 Solar Way\",\n  \"capacityKw\": 9.0,\n  \"active\": true\n}", "options": { "raw": { "language": "json" } } },
            "url": "{{baseUrl}}/api/admin/sites/{{siteId}}",
            "description": "Updates site metadata. Ownership cannot change after operational/history records depend on the site."
          }
        },
        { "name": "Delete Site", "request": { "method": "DELETE", "url": "{{baseUrl}}/api/admin/sites/{{siteId}}", "description": "Deletes only dependency-free sites; otherwise returns 409 to protect telemetry." } }
      ]
    },
    {
      "name": "Admin - Devices",
      "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{adminAccessToken}}", "type": "string" }] },
      "item": [
        { "name": "List Devices", "request": { "method": "GET", "url": "{{baseUrl}}/api/admin/devices?page=0&size=20&status=ONLINE&type=SOLAR_INVERTER&siteId={{siteId}}", "description": "Paginated device inventory with optional status, type, and site filters." } },
        { "name": "Get Device", "request": { "method": "GET", "url": "{{baseUrl}}/api/admin/devices/{{deviceId}}", "description": "Returns one device and its site/owner references." } },
        {
          "name": "Create Device",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Device created', function () { pm.response.to.have.status(201); });",
            "if (pm.response.code === 201) pm.collectionVariables.set('deviceId', pm.response.json().id);"
          ] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"identifier\": \"INV-001\",\n  \"name\": \"Roof Inverter\",\n  \"type\": \"SOLAR_INVERTER\",\n  \"status\": \"ONLINE\",\n  \"siteId\": {{siteId}},\n  \"manufacturer\": \"Solaris\",\n  \"model\": \"INV-X\",\n  \"firmwareVersion\": \"1.0.0\",\n  \"lastSeenAt\": \"2026-10-01T12:00:00Z\"\n}", "options": { "raw": { "language": "json" } } },
            "url": "{{baseUrl}}/api/admin/devices",
            "description": "Registers a uniquely identified device on an existing homeowner site."
          }
        },
        {
          "name": "Update Device",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"identifier\": \"INV-001\",\n  \"name\": \"Roof Inverter Updated\",\n  \"type\": \"SOLAR_INVERTER\",\n  \"status\": \"MAINTENANCE\",\n  \"siteId\": {{siteId}},\n  \"manufacturer\": \"Solaris\",\n  \"model\": \"INV-X\",\n  \"firmwareVersion\": \"1.1.0\",\n  \"lastSeenAt\": \"2026-10-01T12:00:00Z\"\n}", "options": { "raw": { "language": "json" } } },
            "url": "{{baseUrl}}/api/admin/devices/{{deviceId}}",
            "description": "Updates device details. A device with telemetry or alerts cannot move between sites."
          }
        },
        { "name": "Delete Device", "request": { "method": "DELETE", "url": "{{baseUrl}}/api/admin/devices/{{deviceId}}", "description": "Deletes only devices without telemetry or alert dependencies." } }
      ]
    },
    {
      "name": "Admin - Batteries",
      "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{adminAccessToken}}", "type": "string" }] },
      "item": [
        { "name": "List Batteries", "request": { "method": "GET", "url": "{{baseUrl}}/api/admin/batteries?page=0&size=20", "description": "Returns paginated storage assets." } },
        { "name": "Get Battery", "request": { "method": "GET", "url": "{{baseUrl}}/api/admin/batteries/{{batteryId}}", "description": "Returns one battery and its current state." } },
        {
          "name": "Create Battery",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Battery created', function () { pm.response.to.have.status(201); });",
            "if (pm.response.code === 201) pm.collectionVariables.set('batteryId', pm.response.json().id);"
          ] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"identifier\": \"BAT-001\",\n  \"name\": \"Garage Battery\",\n  \"siteId\": {{siteId}},\n  \"capacityKwh\": 13.5,\n  \"status\": \"ONLINE\",\n  \"currentChargePercent\": 65,\n  \"currentStoredEnergyKwh\": 8.775,\n  \"lastUpdatedAt\": \"2026-10-01T12:00:00Z\"\n}", "options": { "raw": { "language": "json" } } },
            "url": "{{baseUrl}}/api/admin/batteries",
            "description": "Registers a battery. Stored energy may not exceed its capacity."
          }
        },
        {
          "name": "Update Battery",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"identifier\": \"BAT-001\",\n  \"name\": \"Garage Battery Updated\",\n  \"siteId\": {{siteId}},\n  \"capacityKwh\": 13.5,\n  \"status\": \"ONLINE\",\n  \"currentChargePercent\": 70,\n  \"currentStoredEnergyKwh\": 9.45,\n  \"lastUpdatedAt\": \"2026-10-01T12:30:00Z\"\n}", "options": { "raw": { "language": "json" } } },
            "url": "{{baseUrl}}/api/admin/batteries/{{batteryId}}",
            "description": "Updates the current battery snapshot. Historical data prevents cross-site movement."
          }
        },
        { "name": "Delete Battery", "request": { "method": "DELETE", "url": "{{baseUrl}}/api/admin/batteries/{{batteryId}}", "description": "Deletes only batteries without history or alert dependencies." } }
      ]
    },
    {
      "name": "Admin - Settings and Alerts",
      "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{adminAccessToken}}", "type": "string" }] },
      "item": [
        { "name": "Get System Settings", "request": { "method": "GET", "url": "{{baseUrl}}/api/admin/settings", "description": "Returns the singleton alert-rule configuration." } },
        {
          "name": "Update System Settings",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"lowBatteryThreshold\": 20,\n  \"highConsumptionThresholdKwh\": 10,\n  \"lowProductionThresholdKwh\": 1,\n  \"productionAlertsEnabled\": true,\n  \"consumptionAlertsEnabled\": true,\n  \"batteryAlertsEnabled\": true,\n  \"deviceOfflineAlertEnabled\": true,\n  \"deviceOfflineThresholdMinutes\": 30,\n  \"emailNotificationsEnabled\": false\n}", "options": { "raw": { "language": "json" } } },
            "url": "{{baseUrl}}/api/admin/settings",
            "description": "Changes alert-generation thresholds and feature flags; it does not create alert records directly."
          }
        },
        { "name": "List Administrative Alerts", "request": { "method": "GET", "url": "{{baseUrl}}/api/admin/alerts?type=LOW_BATTERY&severity=WARNING&read=false&userId={{homeownerUserId}}&page=0&size=20", "description": "Searches persisted alert events across users with optional filters." } }
      ]
    },
    {
      "name": "Homeowner - Profile and Sites",
      "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{homeownerAccessToken}}", "type": "string" }] },
      "item": [
        { "name": "Get My Profile", "request": { "method": "GET", "url": "{{baseUrl}}/api/homeowner/profile", "description": "Returns only the authenticated homeowner's profile." } },
        {
          "name": "Update My Profile",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Solar Homeowner Updated\",\n  \"email\": \"{{homeownerEmail}}\",\n  \"phone\": \"+1 555 0199\"\n}", "options": { "raw": { "language": "json" } } },
            "url": "{{baseUrl}}/api/homeowner/profile",
            "description": "Updates the authenticated profile. Changing email invalidates existing JWT subjects, so log in again afterward."
          }
        },
        { "name": "List My Sites", "request": { "method": "GET", "url": "{{baseUrl}}/api/homeowner/sites", "description": "Lists only sites owned by the authenticated homeowner." } },
        { "name": "Get My Site", "request": { "method": "GET", "url": "{{baseUrl}}/api/homeowner/sites/{{siteId}}", "description": "Returns the site only when it belongs to the authenticated homeowner; otherwise 404." } }
      ]
    },
    {
      "name": "Homeowner - Energy and Reports",
      "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{homeownerAccessToken}}", "type": "string" }] },
      "item": [
        { "name": "Energy Summary", "request": { "method": "GET", "url": "{{baseUrl}}/api/homeowner/energy/summary?siteId={{siteId}}&from={{fromInstant}}&to={{toInstant}}", "description": "Aggregates production, consumption, grid import/export, and count for an owned site and bounded time range." } },
        { "name": "Energy Readings", "request": { "method": "GET", "url": "{{baseUrl}}/api/homeowner/energy/readings?siteId={{siteId}}&from={{fromInstant}}&to={{toInstant}}&page=0&size=50", "description": "Returns owned raw energy readings in reverse chronological pages." } },
        { "name": "Daily Energy Report", "request": { "method": "GET", "url": "{{baseUrl}}/api/homeowner/reports/energy?siteId={{siteId}}&from={{fromDate}}&to={{toDate}}", "description": "Runs the parameterized JDBC daily aggregation for an owned site, up to 366 days." } }
      ]
    },
    {
      "name": "Homeowner - Storage and Alerts",
      "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{homeownerAccessToken}}", "type": "string" }] },
      "item": [
        { "name": "Storage Status", "request": { "method": "GET", "url": "{{baseUrl}}/api/homeowner/storage/status", "description": "Returns current battery snapshots only for the homeowner's sites." } },
        { "name": "Storage History", "request": { "method": "GET", "url": "{{baseUrl}}/api/homeowner/storage/history?batteryId={{batteryId}}&from={{fromInstant}}&to={{toInstant}}&page=0&size=50", "description": "Returns paginated historical storage readings after checking battery ownership." } },
        { "name": "List My Alerts", "request": { "method": "GET", "url": "{{baseUrl}}/api/homeowner/alerts?read=false&page=0&size=20", "description": "Returns only the authenticated homeowner's persisted alerts, optionally filtered by read state." } },
        { "name": "Mark My Alert Read", "request": { "method": "PUT", "url": "{{baseUrl}}/api/homeowner/alerts/{{alertId}}/read", "description": "Marks an owned alert as read. Another homeowner's alert is deliberately indistinguishable from a missing alert (404)." } }
      ]
    }
  ]
}
